# .env.example - Mẫu cấu hình, commit lên GitHub
# Copy thành .env và điền giá trị thật

# Database (PostgreSQL)
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=FlashOfferDb;Username=postgres;Password=postgres;SSL Mode=Prefer

# DB chỉ đọc (tuỳ chọn): đặt khi có replica/DB đọc riêng cho các truy vấn danh sách, chi tiết, tra cứu.
# Bỏ trống thì các truy vấn đọc dùng luôn DB ở trên.
READ_CONNECTION_STRING=

# Số giá trị tối đa cho một điều kiện "chứa một trong các giá trị" (0 = không giới hạn)
QUERY_MAX_CONTAINS_VALUES=1000

# JWT Settings (thay đổi Secret thành key của bạn, ít nhất 32 ký tự)
JWT_SECRET=YourSuperSecretKeyHereAtLeast32CharactersLong!
JWT_ISSUER=FlashOffer.API
JWT_AUDIENCE=FlashOffer.APIClient
JWT_EXPIRY_MINUTES=60

# Serilog
LOG_LEVEL=Information
LOG_OUTPUT_TEMPLATE=[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}

# Seq — log tập trung (local: http://localhost:5341, chạy bằng `docker compose up -d seq`)
# Deploy: đặt SEQ_SERVER_URL = URL Seq đã deploy (+ SEQ_API_KEY nếu Seq bật xác thực).
# Để trống/`false` thì API tự tắt sink, vẫn log ra console + file.
SEQ_SERVER_URL=http://localhost:5341
SEQ_API_KEY=
SEQ_ENABLED=true

# API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,https://flash-offer-ui.vercel.app,https://www.kindi.vn,https://kindi.vn
