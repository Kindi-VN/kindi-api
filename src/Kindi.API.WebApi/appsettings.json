{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FlashOfferDb;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyHereAtLeast32CharactersLong!",
    "Issuer": "FlashOffer.API",
    "Audience": "FlashOffer.APIClient",
    "ExpiryMinutes": 60
  },
  "Query": {
    "DistinctContainsValues": true,
    "MaxContainsValues": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Seq": {
      "Enabled": true,
      "ServerUrl": "http://localhost:5341",
      "ApiKey": null,
      "MinimumLevel": "Information"
    },
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ]
  },
  "Telegram": {
    "ErrorBot": {
      "BotToken": "",
      "ChatId": "1820330587"
    },
    "WarningBot": {
      "BotToken": "another_bot_token",
      "ChatId": "another_chat_id"
    }
  }
}
