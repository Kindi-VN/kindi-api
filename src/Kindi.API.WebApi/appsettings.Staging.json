{
    "ConnectionStrings": {
        "DefaultConnection": "<DB_CONNECTION_STRING>"
    },
    "JwtSettings": {
        "Secret": "<JWT_SECRET_32_CHARS_MIN>",
        "Issuer": "FlashOfferAPI",
        "Audience": "FlashOfferClient",
        "ExpiryMinutes": 60
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information"
        }
    },
    "CorsSettings": {
        "Policy": "AllowSpecific",
        "AllowedOrigins": "https://staging.kindi.vn/,https://www.kindi.vn/"
    },
    "EnableSwagger": true
}